# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────
# Direct connection — used by prisma migrate / prisma studio
DATABASE_URL="postgresql://neondb_owner:npg_qvDy4Vido0WJ@ep-autumn-pond-aq45108u.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Pooled connection (Neon PgBouncer) — used by the running app to avoid cold starts
# In Neon dashboard → your project → Connection Details → select "Pooled connection"
# It looks like: ep-autumn-pond-aq45108u-pooler.c-8.us-east-1.aws.neon.tech
# POOLED_DATABASE_URL="postgresql://neondb_owner:npg_qvDy4Vido0WJ@ep-autumn-pond-aq45108u-pooler.c-8.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Keep-alive ping (opt-in) — prevents Neon from sleeping between requests.
# ⚠️  WARNING: Uses compute hours! Free tier = ~191 hrs/month.
#    true  → fast APIs always, but may exceed Neon free tier (costs money on paid plans)
#    false → first request after 5min idle is slow (3-5s cold start), free tier safe
DB_KEEPALIVE=false

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
API_VERSION=v1

# ─────────────────────────────────────────────────────────────
# JWT SECRETS  (use strong random strings in production)
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=wiftil_access_super_secret_key_change_in_production_2024
JWT_REFRESH_SECRET=wiftil_refresh_super_secret_key_change_in_production_2024
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────────────────
# BCRYPT
# ─────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10