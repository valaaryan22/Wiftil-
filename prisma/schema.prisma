// Wiftil - Dynamic Role-Based Auth + Task Management Schema
// Prisma ORM + PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
  MATERNITY
  PATERNITY
}

enum TokenType {
  REFRESH
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  CREATED
  ASSIGNED           // Admin assigned to Manager
  ACCEPTED           // Manager accepted
  REJECTED           // Manager rejected
  IN_PROGRESS        // Team Lead started work
  SUBMITTED          // Team Lead submitted to Manager
  MANAGER_REVIEW     // Under Manager review
  MANAGER_APPROVED   // Manager approved
  COMPLETED
  REOPENED
}

enum SubTaskStatus {
  CREATED
  ASSIGNED           // Team Lead assigned to Member(s)
  LOCKED             // Has unmet dependencies
  AVAILABLE          // Dependencies met, ready to start
  IN_PROGRESS        // Member working on it
  SUBMITTED          // Member submitted to Team Lead
  TEAM_LEAD_REVIEW
  TEAM_LEAD_APPROVED
  TEAM_LEAD_REJECTED // Sent back to Member
  MANAGER_REVIEW     // Optional manager review
  FINAL_APPROVED
  REOPENED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_ACCEPTED
  TASK_REJECTED
  TASK_SUBMITTED
  TASK_APPROVED
  TASK_REOPENED
  TASK_DUE_SOON
  TASK_OVERDUE
  SUBTASK_ASSIGNED
  SUBTASK_SUBMITTED
  SUBTASK_APPROVED
  SUBTASK_REJECTED
  DEPENDENCY_UNLOCKED
  RATING_SUBMITTED
  MENTION
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

/// Dynamic role definitions — admins can create custom roles with an access level (1–5)
model RoleDefinition {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  accessLevel Int
  isSystem    Boolean  @default(false)
  isActive    Boolean  @default(true)
  color       String?

  users       User[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([accessLevel])
  @@map("role_definitions")
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  password          String
  firstName         String
  lastName          String

  roleId            String
  role              RoleDefinition  @relation(fields: [roleId], references: [id])

  isActive          Boolean         @default(true)
  isEmailVerified   Boolean         @default(false)
  profilePicture    String?
  phone             String?
  department        String?
  jobTitle          String?
  managerId         String?

  // Auth relations
  manager           User?           @relation("UserManager", fields: [managerId], references: [id])
  subordinates      User[]          @relation("UserManager")
  tokens            Token[]
  leaveRequests     LeaveRequest[]  @relation("LeaveRequester")
  reviewedLeaves    LeaveRequest[]  @relation("LeaveReviewer")
  auditLogs         AuditLog[]      @relation("AuditPerformer")
  affectedLogs      AuditLog[]      @relation("AuditTarget")

  // Task relations
  createdTasks      Task[]          @relation("TaskCreator")
  managedTasks      Task[]          @relation("TaskManager")
  taskAssignments   TaskAssignment[] @relation("TeamLeadAssignments")
  taskAssignedBy    TaskAssignment[] @relation("TaskAssignedBy")
  createdSubTasks   SubTask[]       @relation("SubTaskCreator")
  reviewedSubTasks  SubTask[]       @relation("SubTaskReviewer")
  subTaskAssignments SubTaskAssignment[] @relation("MemberAssignments")
  subTaskAssignedBy  SubTaskAssignment[] @relation("SubTaskAssignedBy")
  ratingsReceived   PerformanceRating[] @relation("RatedUser")
  ratingsGiven      PerformanceRating[] @relation("RatingGiver")
  taskComments      TaskComment[]   @relation("CommentAuthor")
  taskAttachments   TaskAttachment[] @relation("AttachmentUploader")
  notifications     Notification[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([roleId])
  @@map("users")
}

model Token {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  type        TokenType
  expiresAt   DateTime
  isRevoked   Boolean   @default(false)
  deviceInfo  String?
  ipAddress   String?

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([token])
  @@map("tokens")
}

model LeaveRequest {
  id            String      @id @default(uuid())
  requesterId   String
  reviewerId    String?
  leaveType     LeaveType
  status        LeaveStatus @default(PENDING)
  startDate     DateTime
  endDate       DateTime
  totalDays     Int
  reason        String
  reviewComment String?
  reviewedAt    DateTime?

  requester     User        @relation("LeaveRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer      User?       @relation("LeaveReviewer", fields: [reviewerId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([requesterId])
  @@index([status])
  @@map("leave_requests")
}

// ─── TASK MANAGEMENT ──────────────────────────────────────────────────────────

/// Main task — created by Admin, flows through Manager → Team Lead → Members
model Task {
  id               String       @id @default(uuid())
  title            String
  description      String?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(CREATED)

  // Time tracking
  startDate        DateTime?
  dueDate          DateTime?
  estimatedHours   Float?
  actualHours      Float        @default(0)
  completionPercent Float       @default(0)

  // Creator (Admin)
  createdById      String
  createdBy        User         @relation("TaskCreator", fields: [createdById], references: [id])

  // Assigned Manager
  managerId        String?
  manager          User?        @relation("TaskManager", fields: [managerId], references: [id])

  // Manager decision
  managerRemark    String?
  managerActionAt  DateTime?    // when accepted/rejected

  // Submission & approval
  submittedAt      DateTime?    // when Team Lead submitted
  approvedAt       DateTime?    // when Manager approved
  completedAt      DateTime?

  // Soft delete
  deletedAt        DateTime?

  // Relations
  assignments      TaskAssignment[]
  subTasks         SubTask[]
  comments         TaskComment[]    @relation("TaskComments")
  attachments      TaskAttachment[] @relation("TaskAttachments")

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
  @@index([managerId])
  @@index([createdById])
  @@index([dueDate])
  @@map("tasks")
}

/// Many-to-many: Task assigned to one or more Team Leads by Manager
model TaskAssignment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamLeadId   String
  teamLead     User     @relation("TeamLeadAssignments", fields: [teamLeadId], references: [id])
  assignedById String
  assignedBy   User     @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  assignedAt   DateTime @default(now())

  @@unique([taskId, teamLeadId])
  @@index([taskId])
  @@index([teamLeadId])
  @@map("task_assignments")
}

/// Sub-task — created by Team Lead, assigned to one or more Members
model SubTask {
  id             String        @id @default(uuid())
  taskId         String
  task           Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  priority       TaskPriority  @default(MEDIUM)
  status         SubTaskStatus @default(CREATED)

  // Time tracking
  startDate      DateTime?
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float         @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  submittedAt    DateTime?

  // Creator (Team Lead)
  createdById    String
  createdBy      User          @relation("SubTaskCreator", fields: [createdById], references: [id])

  // Reviewer (Team Lead who reviews)
  reviewedById   String?
  reviewedBy     User?         @relation("SubTaskReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewComment  String?

  // Relations
  assignments    SubTaskAssignment[]
  dependencies   SubTaskDependency[] @relation("DependentSubTask")   // this task depends on these
  dependents     SubTaskDependency[] @relation("PrerequisiteSubTask") // these tasks depend on this
  ratings        PerformanceRating[]
  comments       TaskComment[]    @relation("SubTaskComments")
  attachments    TaskAttachment[] @relation("SubTaskAttachments")

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([taskId])
  @@index([status])
  @@index([dueDate])
  @@map("sub_tasks")
}

/// Many-to-many: SubTask assigned to one or more Members with % contribution
model SubTaskAssignment {
  id             String   @id @default(uuid())
  subTaskId      String
  subTask        SubTask  @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  memberId       String
  member         User     @relation("MemberAssignments", fields: [memberId], references: [id])
  contribution   Float    @default(100) // percentage 0–100
  assignedById   String
  assignedBy     User     @relation("SubTaskAssignedBy", fields: [assignedById], references: [id])
  assignedAt     DateTime @default(now())

  @@unique([subTaskId, memberId])
  @@index([subTaskId])
  @@index([memberId])
  @@map("sub_task_assignments")
}

/// Dependency: subTaskId cannot start until prerequisiteId is approved
model SubTaskDependency {
  id             String  @id @default(uuid())
  subTaskId      String  // the blocked task
  subTask        SubTask @relation("DependentSubTask",   fields: [subTaskId],     references: [id], onDelete: Cascade)
  prerequisiteId String  // must be approved first
  prerequisite   SubTask @relation("PrerequisiteSubTask", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([subTaskId, prerequisiteId])
  @@map("sub_task_dependencies")
}

/// Performance rating — Manager rates Member(s) on a completed Sub-task
model PerformanceRating {
  id           String   @id @default(uuid())
  subTaskId    String
  subTask      SubTask  @relation(fields: [subTaskId], references: [id], onDelete: Cascade)

  // Who is rated
  ratedUserId  String
  ratedUser    User     @relation("RatedUser", fields: [ratedUserId], references: [id])

  // Who gave the rating
  ratedById    String
  ratedBy      User     @relation("RatingGiver", fields: [ratedById], references: [id])

  // 5 criteria, each 1–10
  quality       Int
  timeliness    Int
  communication Int
  accuracy      Int
  ownership     Int
  overall       Float   // auto-calculated average

  comments      String?
  ratedAt       DateTime @default(now())

  @@unique([subTaskId, ratedUserId])
  @@index([ratedUserId])
  @@index([subTaskId])
  @@map("performance_ratings")
}

/// Comments on tasks or sub-tasks with @mention support
model TaskComment {
  id        String   @id @default(uuid())

  // Belongs to either a task OR a sub-task (not both)
  taskId    String?
  task      Task?    @relation("TaskComments",    fields: [taskId],    references: [id], onDelete: Cascade)
  subTaskId String?
  subTask   SubTask? @relation("SubTaskComments", fields: [subTaskId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id])

  content   String
  mentions  String[] // array of user IDs @mentioned

  editedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([subTaskId])
  @@map("task_comments")
}

/// File attachments on tasks or sub-tasks
model TaskAttachment {
  id           String   @id @default(uuid())

  taskId       String?
  task         Task?    @relation("TaskAttachments",    fields: [taskId],    references: [id], onDelete: Cascade)
  subTaskId    String?
  subTask      SubTask? @relation("SubTaskAttachments", fields: [subTaskId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User     @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?

  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([subTaskId])
  @@map("task_attachments")
}

/// In-app notification
model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  entityType String?          // "Task" | "SubTask"
  entityId   String?          // ID of the related entity
  isRead     Boolean          @default(false)
  readAt     DateTime?

  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── AUDIT LOG ────────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(uuid())

  performedById   String?
  performedBy     User?    @relation("AuditPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  performedByName String?
  performedByRole String?

  action          String
  category        String   @default("GENERAL")
  description     String?

  entity          String
  entityId        String?
  entityName      String?

  targetUserId    String?
  targetUser      User?    @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetUserName  String?

  oldValues       Json?
  newValues       Json?
  metadata        Json?

  ipAddress       String?
  userAgent       String?
  status          String   @default("SUCCESS")

  createdAt       DateTime @default(now())

  @@index([performedById])
  @@index([targetUserId])
  @@index([entity, entityId])
  @@index([action])
  @@index([category])
  @@index([createdAt])
  @@map("audit_logs")
}
