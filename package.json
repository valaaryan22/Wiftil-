{
  "name": "wiftil",
  "version": "1.0.0",
  "description": "Wiftil - Dynamic Role-Based Auth API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:sync": "node -e \"require('./src/models').sequelize.sync({ alter: true }).then(() => { console.log('DB synced'); process.exit(0); })\"",
    "db:sync:force": "node -e \"require('./src/models').sequelize.sync({ force: true }).then(() => { console.log('DB force synced'); process.exit(0); })\"",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/setup-aws-db.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "puppeteer": "^25.13.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
